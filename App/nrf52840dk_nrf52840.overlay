/* nrf52840dk_nrf52840.overlay - CORREÇÃO LÓGICA FINAL */

/ {
    aliases {
        // MANTEMOS OS ALIASES PARA OS LEDs (led0 a led3)
        ledsquare = &led0;      
        ledtriangle = &led1;    
        ledsine = &led2;        
        ledstatus = &led3;      

        btnwavetype = &button0;        
        btnfrequency = &button1;        
        btnoutputtoggle = &button2;
        btnamplitude = &button3;        
        
        siggenpwm = &pwm0;
    };
};

// 2. CONFIGURAÇÃO FINAL DO PWM0 (Remapeamento para P0.08, pino D7)
&pwm0 {
    status = "okay";
    
    // ATRIBUIÇÃO AO GRUPO DE PINOS DEDICADO
    pinctrl-0 = <&pwm0_siggen_pin>;
    pinctrl-1 = <&pwm0_sleep_pin>; 
    pinctrl-names = "default", "sleep"; // Resolve o contrato de pinagem
};

// --- NOVO BLOCO &pinctrl NO OVERLAY (SOLUÇÃO) ---

// --- NOVO BLOCO &pinctrl NO OVERLAY (SOLUÇÃO FINAL) ---

&pinctrl {
    // Definir o estado REPOUSO/DESLIGADO (Usando um valor DT literal)
    // O valor 0x1F (31) ou o valor PSEL máximo é frequentemente usado para 'disconnected'
    pwm0_sleep_pin: pwm0_sleep_pin {
        group {
            // Usaremos 0x1FUL (o valor do pino NRF_PSEL_DISCONNECTED)
            psels = <0x1FUL>; 
        };
    };
    
    // O seu bloco pwm0_siggen_pin (Usando o valor de P0.08)
    pwm0_siggen_pin: pwm0_siggen_pin {
        group {
            // NRF_PSEL(PWM_OUT0, 0, 8) geralmente expande-se para um valor literal
            // O valor literal para P0.08 é (Porta 0, Pino 8)
            psels = <0x0008>; // Usamos o valor literal do pino: P0.08 = 0x0008
        };
    };
};

// ... e garantir que &pwm0 aponta para estas definições ...
&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_siggen_pin>;
    pinctrl-1 = <&pwm0_sleep_pin>; 
    pinctrl-names = "default", "sleep";
};