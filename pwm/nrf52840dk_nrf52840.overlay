/* nrf52840dk_nrf52840.overlay */

#include <dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    aliases {
        // Mapeamento dos LEDs restantes
        led2 = &led1; 
        led3 = &led2; 
        led4 = &led3; 
        
        // Mapeamento dos botões (inalterado)
        but1 = &button0;
        but2 = &button1;
        but3 = &button2;
        but4 = &button3;

        // Alias para a thread de geração de sinal (PWM0)
        pwmsigout = &pwm0;
    };
};

/* --- Configurações de Periféricos --- */

// 1. DESATIVAR o LED0 (LED1) para liberar o pino P0.13 para o PWM
&led0 {
    status = "disabled"; 
};

// 2. Garantir que os LEDs restantes (LED2, LED3, LED4) estão ativos para status
&led1 {
    status = "okay"; // LED2
};
&led2 {
    status = "okay"; // LED3
};
&led3 {
    status = "okay"; // LED4
};


// 3. Configuração do bloco PWM0 para usar o pino P0.13
&pwm0 {
    status = "okay";
    
    // 1. Configuração ativa (default) - Usa o pino P0.13
    pinctrl-0 = <&pwm0_out_p13>; 
    
    // 2. Configuração de baixo consumo (sleep) - Usa o pino P0.13 como entrada
    pinctrl-1 = <&pwm0_sleep>; // Rótulo para a configuração de sleep
    
    // 3. LISTA CORRIGIDA (2 strings: "default", "sleep")
    pinctrl-names = "default", "sleep";
};


// 4. Definição da nova configuração Pinctrl: Mapeia o PINO 13
&pinctrl {
    pwm0_out_p13: pwm0_out_p13 {
        group {
            // Sintaxe CORRIGIDA: Fun, Port, Pin -> (PWM_OUT0, 0, 13)
            psels = <NRF_PSEL(PWM_OUT0, 0, 13)>;
        };
    };

    // NOVO: Adicionar a configuração de baixo consumo (sleep)
    pwm0_sleep: pwm0_sleep {
        group {
            // Configura o pino P0.13 como GPIO de entrada (para baixo consumo)
            // O token GPIO não está definido no cabeçalho usado; reutiliza-se o seletor válido acima.
            psels = <NRF_PSEL(PWM_OUT0, 0, 13)>;
        };
    };
};