/* nrf52840dk_nrf52840.overlay */
#include <dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    aliases {
        /* Aliases para Botões e LEDs (Mantidos) */
        but1 = &button0;
        but2 = &button1;
        but3 = &button2;
        but4 = &button3;
        ledsquare = &led0;
        ledtriangle = &led1;
        ledsine = &led2;
        ledactive = &led3;

        /* CORREÇÃO CRÍTICA: */
        /* O alias signal-pwm agora aponta para o NÓ LÓGICO, não para o controlador de hardware */
        signal-pwm = &pwm_signal_node; 
    };

    /* Definir um "consumidor" de PWM. É isto que a macro PWM_DT_SPEC_GET espera ler! */
    pwmleds {
        compatible = "pwm-leds";
        pwm_signal_node: pwm_signal_node {
            /* PWM0, Canal 0, Periodo inicial 20us (50kHz), Flags */
            pwms = <&pwm0 0 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
    };
};

/* Configuração do Hardware PWM0 (Controlador) */
&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_out_custom>;
    pinctrl-1 = <&pwm0_sleep_custom>;
    pinctrl-names = "default", "sleep";
};

/* Configuração dos Pinos (Pin Control) */
&pinctrl {
    pwm0_out_custom: pwm0_out_custom {
        group {
            /* Mapeia para P0.03 (A0) */
            psels = <NRF_PSEL(PWM_OUT0, 0, 3)>;
            nordic,invert;
        };
    };

    pwm0_sleep_custom: pwm0_sleep_custom {
        group {
            psels = <NRF_PSEL(PWM_OUT0, 0, 3)>;
            low-power-enable;
        };
    };
};

/* Garantir periféricos ativos */
&button0 { status = "okay"; };
&button1 { status = "okay"; };
&button2 { status = "okay"; };
&button3 { status = "okay"; };
&led0 { status = "okay"; };
&led1 { status = "okay"; };
&led2 { status = "okay"; };
&led3 { status = "okay"; };